# Running from source: copy to .env.local and fill in. .env.local is never committed.
# Desktop app: put the same lines in settings.env in the app's data folder (see README).

# Claude (default AI when set). Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: which Claude models to use.
# MODEL_MAIN=claude-opus-5-5
# MODEL_FAST=claude-haiku-5-5

# Optional offline fallback: a local Ollama server.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# OpenRouter key: used for Ask AI, the tutor chat, AI Quiz, Test Me and Notes when no
# ANTHROPIC_API_KEY is set. https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Any OpenAI-compatible key also works in its place.
# OPENAI_API_KEY=
# Which OpenRouter model to use. Default: openrouter/free (routes to whichever free model
# is available; costs nothing). Paid examples: anthropic/claude-haiku-5.5, anthropic/claude-sonnet-5.5
# AI_MODEL=

# Optional: lets "Find a video explaining this" search and rank YouTube videos inside the app.
# Free key: https://console.cloud.google.com → create a project → enable "YouTube Data API v3"
# → Credentials → Create API key. Without it the app offers ready-made YouTube search links.
# YOUTUBE_API_KEY=
