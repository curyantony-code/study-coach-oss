{
  "name": "study-coach",
  "version": "0.1.0",
  "productName": "Study Coach",
  "description": "Adaptive study app that turns your class notes into flashcards, quizzes and a study plan",
  "license": "MIT",
  "author": "Study Coach contributors",
  "private": true,
  "scripts": {
    "dev": "next dev -H localhost -p 3000",
    "build": "next build",
    "start": "next start -H localhost -p 3000",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "desktop": "npm run desktop:prepare && electron .",
    "desktop:pack": "npm run desktop:prepare && electron-builder --mac dir",
    "desktop:dist": "npm run desktop:prepare && electron-builder",
    "build:reader": "mkdir -p native/bin && swiftc -O native/mac-text-reader.swift -o native/bin/mac-text-reader",
    "check:pages": "electron scripts/check-pages.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@tailwindcss/typography": "^0.5.19",
    "canvas-confetti": "^1.9.4",
    "d3-force": "^3.0.0",
    "fuse.js": "^7.3.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.47",
    "next": "16.2.4",
    "openai": "^6.34.0",
    "picomatch": "^4.0.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.2",
    "ts-fsrs": "^5.4.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-force": "^3.0.10",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.1",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "app.studycoach.desktop",
    "productName": "Study Coach",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/env-file.cjs",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "artifactName": "Study-Coach-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Study-Coach-${version}-windows-setup.${ext}"
    },
    "afterPack": "scripts/desktop-after-pack.cjs",
    "publish": null
  }
}
